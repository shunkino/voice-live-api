# ── Local sample settings ─────────────────────────────────────────────────────
# Display/deployment name for the weather agent (informational only)
WEATHER_AGENT_NAME=weather-forecast-agent

# Weather data provider: mock (default) | jma (live Japan Meteorological Agency)
# v1 uses mock by default so the demo runs without any paid data subscription.
WEATHER_PROVIDER=mock

# Local server host and port for `python -m agent.app`
WEATHER_AGENT_HOST=127.0.0.1
WEATHER_AGENT_PORT=8080

# ── Foundry / Voice Live deployment (required for hosted endpoint) ─────────────
# Foundry project name (used in the hosted invocations_ws endpoint query string)
# PROJECT_NAME=<your-foundry-project-name>

# Hosted agent name registered in the Foundry project
# AGENT_NAME=<your-hosted-agent-name>

# Voice Live / Foundry resource endpoint
# AZURE_VOICELIVE_ENDPOINT=https://<resource>.services.ai.azure.com/

# Model deployment name (gpt-realtime for voice workloads)
MODEL_DEPLOYMENT_NAME=gpt-realtime

# Japanese voice for spoken responses (optional, defaults to Nanami)
VOICE_NAME=ja-JP-NanamiNeural

# Primary speech recognition language
AZURE_VOICELIVE_TRANSCRIPTION_LANGUAGE=ja
