# ── Connection ──────────────────────────────────────────────────────────────
AZURE_VOICELIVE_ENDPOINT=https://your-resource-name.services.ai.azure.com/
# Chat model / agent. gpt-realtime works with every transcription model.
# Text models like gpt-4.1 work with azure-speech and mai-transcribe-1.
AZURE_VOICELIVE_MODEL=gpt-realtime
# Provide a key OR set AZURE_VOICELIVE_USE_TOKEN=true and run `az login`.
# AZURE_VOICELIVE_API_KEY=
AZURE_VOICELIVE_USE_TOKEN=true

AZURE_VOICELIVE_INSTRUCTIONS=You are a helpful AI assistant. Respond naturally and conversationally. Keep your responses concise but engaging.

# ── Run mode ──────────────────────────────────────────────────────────────────
# cli = terminal mic/speaker; web = browser + avatar
AZURE_VOICELIVE_MODE=cli
AZURE_VOICELIVE_WEB_HOST=127.0.0.1
AZURE_VOICELIVE_WEB_PORT=8000

# ── Feature 1: custom voice ───────────────────────────────────────────────────
# voice type: standard | personal | custom | avatar-voice-sync
AZURE_VOICELIVE_VOICE_TYPE=standard
AZURE_VOICELIVE_VOICE=en-US-Ava:DragonHDLatestNeural
# For personal / avatar-voice-sync voices (to "sound like me"):
#   DragonLatestNeural | DragonHDOmniLatestNeural | PhoenixLatestNeural | PhoenixV2Neural | MAI-Voice-1
AZURE_VOICELIVE_VOICE_BASE_MODEL=DragonLatestNeural
# For a professional custom voice (azure-custom):
# AZURE_VOICELIVE_VOICE_ENDPOINT_ID=00000000-0000-0000-0000-000000000000
AZURE_VOICELIVE_VOICE_TEMPERATURE=0.8
# AZURE_VOICELIVE_VOICE_RATE=1.0
# AZURE_VOICELIVE_VOICE_LOCALE=en-US
# AZURE_VOICELIVE_VOICE_STYLE=cheerful
# AZURE_VOICELIVE_LEXICON_URL=

# ── Feature 2: face avatar (web mode) ─────────────────────────────────────────
AZURE_VOICELIVE_AVATAR=false
# video-avatar | photo-avatar
AZURE_VOICELIVE_AVATAR_TYPE=video-avatar
AZURE_VOICELIVE_AVATAR_CHARACTER=lisa
AZURE_VOICELIVE_AVATAR_STYLE=casual-sitting
AZURE_VOICELIVE_AVATAR_CUSTOMIZED=false
# Base model for photo avatars (e.g. vasa-1)
# AZURE_VOICELIVE_AVATAR_MODEL=vasa-1

# ── Local face model (avatar OFF + animation cues) ────────────────────────────
# Drive your OWN face model in the browser instead of the server-rendered video
# avatar. Keep AZURE_VOICELIVE_AVATAR=false and enable one or both animation
# streams below; the web client renders a face and maps the cues onto its rig.
# Viseme IDs (0-21) drive lip-sync; blendshapes add brows / blinks / smile.
AZURE_VOICELIVE_VISEME=false
AZURE_VOICELIVE_BLENDSHAPES=false

# ── Feature 3: transcription model ────────────────────────────────────────────
# azure-speech | mai-transcribe-1 | whisper-1 | gpt-4o-transcribe | gpt-4o-mini-transcribe | gpt-4o-transcribe-diarize
AZURE_VOICELIVE_TRANSCRIPTION_MODEL=azure-speech
AZURE_VOICELIVE_TRANSCRIPTION_LANGUAGE=en
